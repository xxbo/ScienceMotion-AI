  "narration": [
    { "id": "narration-problem", "text": "CPU 很快，内存为什么跟不上？处理器需要数据，等待数据却可能浪费大量计算时间。", "claimIds": ["claim-memory-latency"], "voiceDirection": "自然、好奇、开场有吸引力", "timing": { "startFrame": 0, "endFrame": 240 } },
    { "id": "narration-wait", "text": "当数据供应跟不上执行速度，处理器就可能停下来等待。算得再快，也要等数据送到。", "claimIds": ["claim-memory-latency"], "voiceDirection": "解释性、稍有强调", "timing": { "startFrame": 240, "endFrame": 480 } },
    { "id": "narration-hierarchy", "text": "缓存分为多个层级：L1、L2、L3，以及更远的主存。越靠近核心通常越快、容量越小；越往下，容量越大。", "claimIds": ["claim-cache-levels"], "voiceDirection": "清晰、节奏平稳", "timing": { "startFrame": 480, "endFrame": 780 } },
    { "id": "narration-hit", "text": "如果数据已经在缓存中，这次访问就是缓存命中，数据可以沿较短路径返回。", "claimIds": ["claim-hit-miss"], "voiceDirection": "简洁、正向", "timing": { "startFrame": 780, "endFrame": 1080 } },
    { "id": "narration-miss", "text": "如果缓存没有目标数据，就会发生未命中，需要继续向更低层级查找，必要时访问主存。", "claimIds": ["claim-hit-miss"], "voiceDirection": "解释性、强调路径变长", "timing": { "startFrame": 1080, "endFrame": 1380 } },
    { "id": "narration-locality", "text": "缓存有效，还因为程序具有局部性：会重复访问近期数据，也常访问相邻数据。", "claimIds": ["claim-locality"], "voiceDirection": "清楚、稍放慢", "timing": { "startFrame": 1380, "endFrame": 1620 } },
    { "id": "narration-outro", "text": "缓存通过分层存储和利用局部性，让数据更靠近计算单元，减少等待。", "claimIds": ["claim-cache-levels", "claim-locality"], "voiceDirection": "总结、收束", "timing": { "startFrame": 1620, "endFrame": 1800 } }
  ],
