{
  "name": "sciencemotion-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted code-driven science explainer video production",
  "type": "module",
  "scripts": {
    "studio": "npm run voice:generate && remotion studio src/index.ts",
    "render": "npm run voice:generate && remotion render src/index.ts ScienceMotionDemo out/science-motion-demo.mp4",
    "render:still": "npm run voice:generate && remotion still src/index.ts ScienceMotionDemo out/preview.png --frame=45",
    "typecheck": "tsc --noEmit",
    "voice:generate": "node scripts/voice/run-voice.mjs",
    "validate:video": "node scripts/validate-video.mjs out/science-motion-demo.mp4",
    "validate:episode": "node scripts/validate-episode.mjs",
    "render:storyboard": "node scripts/render-storyboard-svg.mjs",
    "validate:project": "node scripts/validate-project.mjs",
    "validate:project-patch": "node scripts/validate-project-patch.mjs",
    "test": "tsx --test src/platform/*.test.ts",
    "validate:tool-manifests": "node scripts/validate-tool-manifests.mjs",
    "validate:plugin-manifests": "node scripts/validate-plugin-manifests.mjs"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "ajv": "^8.17.1",
    "tsx": "^4.19.2",
    "@types/node": "^22.0.0",
    "fast-check": "^3.23.2"
  }
}
