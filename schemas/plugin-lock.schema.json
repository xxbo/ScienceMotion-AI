{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xxbo.github.io/ScienceMotion-AI/schemas/plugin-lock.schema.json",
  "title": "ScienceMotion Plugin Version Lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectSchemaVersion",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "projectSchemaVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
    },
    "plugins": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9._-]+$",
        "type": "string"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]*)[.](0|[1-9][0-9]*)[.](0|[1-9][0-9]*)$"
      }
    }
  }
}
