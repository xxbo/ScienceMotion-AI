{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xxbo.github.io/ScienceMotion-AI/schemas/plugin-manifest.schema.json",
  "title": "ScienceMotion Agent Tool Plugin Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "name", "description", "toolIds"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]+$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pluginId"],
        "properties": {
          "pluginId": { "type": "string", "minLength": 1 },
          "versionRange": { "type": "string" },
          "optional": { "type": "boolean" }
        }
      }
    },
    "toolIds": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "permissions": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "lifecycle": { "enum": ["stable", "beta", "deprecated"] }
  }
}
