{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xxbo.github.io/ScienceMotion-AI/schemas/project-patch.schema.json",
  "title": "ScienceMotion Project Patch",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "baseRevisionId",
    "patches"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "baseRevisionId": {
      "type": "string",
      "minLength": 1
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "sceneId",
              "node"
            ],
            "properties": {
              "op": {
                "const": "add-node"
              },
              "sceneId": {
                "type": "string"
              },
              "node": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "type",
                  "transform",
                  "components"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "enum": [
                      "group",
                      "text",
                      "shape",
                      "path",
                      "mesh",
                      "image",
                      "video",
                      "camera",
                      "light",
                      "emitter",
                      "simulation",
                      "custom"
                    ]
                  },
                  "parentId": {
                    "type": "string"
                  },
                  "childIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "transform": {
                    "type": "object",
                    "required": [
                      "position",
                      "rotation",
                      "scale"
                    ],
                    "properties": {
                      "position": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "rotation": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "scale": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      }
                    }
                  },
                  "components": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "kind",
                        "data"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string"
                        },
                        "data": {
                          "type": "object"
                        },
                        "engine": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "nodeId",
              "changes"
            ],
            "properties": {
              "op": {
                "const": "update-node"
              },
              "nodeId": {
                "type": "string"
              },
              "changes": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "nodeId"
            ],
            "properties": {
              "op": {
                "const": "remove-node"
              },
              "nodeId": {
                "type": "string"
              },
              "recursive": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "nodeId",
              "sceneId"
            ],
            "properties": {
              "op": {
                "const": "reparent-node"
              },
              "nodeId": {
                "type": "string"
              },
              "newParentId": {
                "type": "string"
              },
              "sceneId": {
                "type": "string"
              }
            }
          }
        ]
      }
    }
  }
}
