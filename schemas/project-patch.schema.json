{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://xxbo.github.io/ScienceMotion-AI/schemas/project-patch.schema.json",
  "title": "ScienceMotion Project Patch",
  "$comment": "Patch 1.1.0 preserves node operations; 1.2.0 adds asset operations; 1.3.0 adds scene, shot and animation editing. ProjectDocument remains 1.1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "projectId",
    "baseRevisionId",
    "patches"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.1.0",
        "1.2.0",
        "1.3.0"
      ]
    },
    "projectId": {
      "type": "string",
      "minLength": 1
    },
    "baseRevisionId": {
      "type": "string",
      "minLength": 1
    },
    "patches": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "sceneId",
              "node"
            ],
            "properties": {
              "op": {
                "const": "add-node"
              },
              "sceneId": {
                "type": "string"
              },
              "node": {
                "type": "object",
                "required": [
                  "id",
                  "name",
                  "type",
                  "transform",
                  "components"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "type": {
                    "enum": [
                      "group",
                      "text",
                      "shape",
                      "path",
                      "mesh",
                      "image",
                      "video",
                      "camera",
                      "light",
                      "emitter",
                      "simulation",
                      "custom"
                    ]
                  },
                  "parentId": {
                    "type": "string"
                  },
                  "childIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "transform": {
                    "type": "object",
                    "required": [
                      "position",
                      "rotation",
                      "scale"
                    ],
                    "properties": {
                      "position": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "rotation": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      },
                      "scale": {
                        "type": "array",
                        "items": {
                          "type": "number"
                        },
                        "minItems": 3,
                        "maxItems": 3
                      }
                    }
                  },
                  "components": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "kind",
                        "data"
                      ],
                      "properties": {
                        "kind": {
                          "type": "string"
                        },
                        "data": {
                          "type": "object"
                        },
                        "engine": {
                          "type": "string"
                        }
                      }
                    }
                  }
                },
                "additionalProperties": true
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "nodeId",
              "changes"
            ],
            "properties": {
              "op": {
                "const": "update-node"
              },
              "nodeId": {
                "type": "string"
              },
              "changes": {
                "type": "object"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "nodeId"
            ],
            "properties": {
              "op": {
                "const": "remove-node"
              },
              "nodeId": {
                "type": "string"
              },
              "recursive": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "nodeId",
              "sceneId"
            ],
            "properties": {
              "op": {
                "const": "reparent-node"
              },
              "nodeId": {
                "type": "string"
              },
              "sceneId": {
                "type": "string"
              },
              "newParentId": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "asset"
            ],
            "properties": {
              "op": {
                "const": "add-asset"
              },
              "asset": {
                "$ref": "#/definitions/asset"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "assetId",
              "asset"
            ],
            "properties": {
              "op": {
                "const": "replace-asset"
              },
              "assetId": {
                "type": "string"
              },
              "asset": {
                "$ref": "#/definitions/asset"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "assetId"
            ],
            "properties": {
              "op": {
                "const": "remove-asset"
              },
              "assetId": {
                "type": "string"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "scene"
            ],
            "properties": {
              "op": {
                "const": "add-scene"
              },
              "scene": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "durationFrames",
                  "rootNodeIds"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "durationFrames": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rootNodeIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "metadata": {
                    "type": "object"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "sceneId",
              "changes"
            ],
            "properties": {
              "op": {
                "const": "update-scene"
              },
              "sceneId": {
                "type": "string",
                "minLength": 1
              },
              "changes": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "durationFrames": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "metadata": {
                    "type": "object"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "sceneId"
            ],
            "properties": {
              "op": {
                "const": "remove-scene"
              },
              "sceneId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "sequenceId",
              "shot"
            ],
            "properties": {
              "op": {
                "const": "add-shot"
              },
              "sequenceId": {
                "type": "string",
                "minLength": 1
              },
              "shot": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "name",
                  "sceneId",
                  "startFrame",
                  "durationFrames"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sceneId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "startFrame": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "durationFrames": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "transitionIn": {
                    "type": "string"
                  },
                  "transitionOut": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "shotId",
              "changes"
            ],
            "properties": {
              "op": {
                "const": "update-shot"
              },
              "shotId": {
                "type": "string",
                "minLength": 1
              },
              "changes": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sceneId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "startFrame": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "durationFrames": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "transitionIn": {
                    "type": "string"
                  },
                  "transitionOut": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "shotId"
            ],
            "properties": {
              "op": {
                "const": "remove-shot"
              },
              "shotId": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "track"
            ],
            "properties": {
              "op": {
                "const": "put-animation-track"
              },
              "track": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "targetNodeId",
                  "targetProperty",
                  "keyframes"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "targetNodeId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "targetProperty": {
                    "type": "string",
                    "minLength": 1
                  },
                  "keyframes": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "$ref": "https://xxbo.github.io/ScienceMotion-AI/schemas/project.schema.json#/definitions/keyframe"
                    }
                  },
                  "loop": {
                    "type": "boolean"
                  },
                  "enabled": {
                    "type": "boolean"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "op",
              "trackId"
            ],
            "properties": {
              "op": {
                "const": "remove-animation-track"
              },
              "trackId": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.1.0"
          }
        }
      },
      "then": {
        "properties": {
          "patches": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "enum": [
                    "add-node",
                    "update-node",
                    "remove-node",
                    "reparent-node"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schemaVersion": {
            "const": "1.2.0"
          }
        },
        "required": [
          "schemaVersion"
        ]
      },
      "then": {
        "properties": {
          "patches": {
            "items": {
              "type": "object",
              "properties": {
                "op": {
                  "enum": [
                    "add-node",
                    "update-node",
                    "remove-node",
                    "reparent-node",
                    "add-asset",
                    "replace-asset",
                    "remove-asset"
                  ]
                }
              }
            }
          }
        }
      }
    }
  ],
  "definitions": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "uri"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "image",
            "video",
            "audio",
            "font",
            "model",
            "texture",
            "data",
            "other"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "contentHash": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "metadata": {
          "type": "object"
        }
      }
    }
  }
}
