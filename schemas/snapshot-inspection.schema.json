{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Snapshot inspection report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "inspector", "snapshotId", "snapshotHash", "projectId", "revisionId", "sequenceId", "outcome", "coverage", "frames", "issues", "issuesTruncated", "omittedIssueOccurrences"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "inspector": {
      "type": "object", "additionalProperties": false, "required": ["id", "version"],
      "properties": { "id": { "const": "project-graph.model" }, "version": { "const": "1.0.0" } }
    },
    "snapshotId": { "type": "string", "minLength": 1 },
    "snapshotHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "projectId": { "type": "string", "minLength": 1 },
    "revisionId": { "type": "string", "minLength": 1 },
    "sequenceId": { "type": "string", "minLength": 1 },
    "outcome": { "enum": ["issues-found", "no-issues-detected"] },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["selection", "mode", "totalFrames", "checkedFrames", "omittedCandidateFrames", "checks", "notChecked"],
      "properties": {
        "selection": { "enum": ["automatic", "explicit"] },
        "mode": { "enum": ["all-frames", "sampled-frames"] },
        "totalFrames": { "type": "integer", "minimum": 1 },
        "checkedFrames": { "type": "array", "minItems": 1, "maxItems": 120, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } },
        "omittedCandidateFrames": { "type": "integer", "minimum": 0 },
        "checks": { "type": "array", "items": { "type": "string" } },
        "notChecked": { "type": "array", "items": { "type": "string" } }
      }
    },
    "frames": {
      "type": "array", "minItems": 1, "maxItems": 120,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["frame", "projectedElements", "visibleCandidates"],
        "properties": {
          "frame": { "type": "integer", "minimum": 0 }, "sceneId": { "type": "string" },
          "projectedElements": { "type": "integer", "minimum": 0 }, "visibleCandidates": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "issues": {
      "type": "array", "maxItems": 200,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["level", "code", "message", "source", "frames"],
        "properties": {
          "level": { "enum": ["warning", "error"] }, "code": { "type": "string" }, "message": { "type": "string" },
          "source": { "enum": ["render-model", "declared-geometry"] },
          "nodeId": { "type": "string" }, "trackId": { "type": "string" }, "sceneId": { "type": "string" },
          "frames": { "type": "array", "minItems": 1, "maxItems": 120, "uniqueItems": true, "items": { "type": "integer", "minimum": 0 } }
        }
      }
    },
    "issuesTruncated": { "type": "boolean" },
    "omittedIssueOccurrences": { "type": "integer", "minimum": 0 }
  }
}
