{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "episodes/**/*.json",
    "scripts/creative-loop-acceptance.ts",
    "scripts/render-png-asset-acceptance.ts",
    "scripts/render-timeline-acceptance.ts",
    "scripts/render-graphics-edit-acceptance.ts",
    "scripts/render-animation-acceptance.ts",
    "scripts/render-narration-acceptance.ts",
    "scripts/catalogue-scale-acceptance.ts",
    "scripts/creative-host-server.ts",
    "scripts/ai-trial-acceptance.ts",
    "scripts/render-job-cli-acceptance.ts",
    "scripts/render-job-host-smoke.ts",
    "scripts/render-job-scheduler-acceptance.ts",
    "scripts/render-job-maintenance-acceptance.ts",
    "scripts/render-worker-resource-acceptance.ts",
    "scripts/render-worker-temporary-acceptance.ts",
    "scripts/render-worker-combined-acceptance.ts",
    "scripts/probe-render-resources.ts",
    "scripts/prepare-render-bundle.ts",
    "scripts/fixtures/**/*.ts"
  ]
}
